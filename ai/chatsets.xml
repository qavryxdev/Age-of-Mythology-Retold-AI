		<Tag name="ToEnemyWhenGameStarts" priority="Emergency">
			<Sentence>
				<String>Anger me, and I will burn your cities and sow salt in the fields.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_1</StringID>
			</Sentence>
			<Sentence>
				<String>It is a pleasure to meet you on the field of battle. I hope you put up a good fight!</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_2</StringID>
			</Sentence>
			<Sentence>
				<String>I hope you don't mind if I destroy each and every last one of your kind. Thanks.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_3</StringID>
			</Sentence>
			<Sentence>
				<String>Good Luck! You're going to need it.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_4</StringID>
			</Sentence>
			<Sentence>
				<String>All of this land will soon be mine.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_5</StringID>
			</Sentence>
			<Sentence>
				<String>Greetings. I will take all your resources to build new temples for my god.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_6</StringID>
			</Sentence>
			<Sentence>
				<String>Just keep your armies in your own lands, and we will get along fine.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_7</StringID>
			</Sentence>
			<Sentence>
				<String>I look forward to conquering your lands in the name of my deity.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_8</StringID>
			</Sentence>
			<Sentence>
				<String>Your presence offends me. Do not come near my cities.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_9</StringID>
			</Sentence>
			<Sentence>
				<String>Hail and well met. Now prepare to be crushed.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_10</StringID>
			</Sentence>
			<Sentence>
				<String>Greetings, mortal.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_11</StringID>
			</Sentence>
			<Sentence>
				<String>Hail, stranger. If you keep to your lands, I might keep to mine.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_12</StringID>
			</Sentence>
			<Sentence>
				<String>This land is too small for all of us. I suggest you surrender now.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_13</StringID>
			</Sentence>
			<Sentence>
				<String>If I can just locate some food, wood, and gold, I will train a huge army to punish you.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_14</StringID>
			</Sentence>
			<Sentence>
				<String>Some empires were destined to rise. Yours, however, will fall.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_15</StringID>
			</Sentence>
			<Sentence>
				<String>My people will be victorious.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_16</StringID>
			</Sentence>
			<Sentence>
				<String>Who are you and what are you doing near my lands?</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_17</StringID>
			</Sentence>
			<Sentence>
				<String>Perhaps my people will build a monument to commemorate your impending defeat.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_18</StringID>
			</Sentence>
			<Sentence>
				<String>Build many, many walls. You'll need them when I arrive.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_19</StringID>
			</Sentence>
			<Sentence>
				<String>If you resigned now, we could save so much time.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_20</StringID>
			</Sentence>
			<Sentence>
				<String>If it's a war you want, that is precisely what you will get.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_21</StringID>
			</Sentence>
			<Sentence>
				<String>To the last, I grapple with thee!</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_22</StringID>
			</Sentence>
			<Sentence>
				<String>I shall pave my roads with the rubble of your shattered empire.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_23</StringID>
			</Sentence>
			<Sentence>
				<String>Let's try and make this a clean fight.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_24</StringID>
			</Sentence>
			<Sentence>
				<String>May all your villagers be killed by wild animals.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_25</StringID>
			</Sentence>
			<Sentence>
				<String>My empire expands slowly, so you'll have to give me plenty of time before you attack.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_26</StringID>
			</Sentence>
			<Sentence>
				<String>I have heard of this god you worship, but I am not impressed.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_27</StringID>
			</Sentence>
			<Sentence>
				<String>There's not enough room in the cosmos for both our pantheons.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_28</StringID>
			</Sentence>
			<Sentence>
				<String>May the best commander win.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_29</StringID>
			</Sentence>
			<Sentence>
				<String>Pray to your gods. You will be seeing them soon.</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_30</StringID>
			</Sentence>
			<Sentence>
				<String>My God can beat up your God!</String>
				<StringID>STR_AI_CHAT_START_OF_GAME_31</StringID>
			</Sentence>
		</Tag>
		
